{
  "id": "tactical-3d-viewer",
  "title": "3D Tactical Viewer",
  "description": "Synchronized 2D tactical projections for three-dimensional battlespaces.",
  "version": "0.1.0",
  "url": "https://github.com/jedvargo/project-tactical-viewer",
  "manifest": "https://github.com/jedvargo/project-tactical-viewer/releases/download/v0.1.0/module.json",
  "download": "https://github.com/jedvargo/project-tactical-viewer/releases/download/v0.1.0/tactical-3d-viewer-0.1.0.zip",
  "authors": [
    {
      "name": "3D Tactical Viewer Contributors"
    }
  ],
  "readme": "README.md",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "flags": {
    "hotReload": {
      "extensions": [
        "js",
        "mjs",
        "css",
        "html",
        "hbs",
        "json"
      ],
      "paths": [
        "scripts",
        "styles",
        "lang"
      ]
    }
  },
  "styles": [
    "styles/tactical-viewer.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "esmodules": [
    "scripts/main.js"
  ]
}
